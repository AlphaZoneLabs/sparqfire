{
  "cli": {
    "version": ">=25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.11.1",
      "env": { "SPARQFIRE_RELEASE": "1" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "ios": { "buildConfiguration": "Release", "simulator": false }
    },
    "simulator": {
      "extends": "preview",
      "ios": { "buildConfiguration": "Release", "simulator": true }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "env": { "SPARQFIRE_RELEASE": "1", "EXPO_PUBLIC_API_URL": "https://sparqfire.getsparqd.com" },
      "autoIncrement": true,
      "ios": { "buildConfiguration": "Release", "simulator": false }
    }
  },
  "submit": { "production": {} }
}
