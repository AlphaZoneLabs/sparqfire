{
  "name": "@sparqfire/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:simulator": "eas build --platform ios --profile simulator",
    "build:ios:production": "eas build --platform ios --profile production",
    "update:ios:preview": "eas env:exec preview \"node ../../scripts/publish-ios-update.mjs preview\"",
    "update:ios:production": "eas env:exec production \"node ../../scripts/publish-ios-update.mjs production\"",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eas-cli": "25.3.0",
    "typescript": "~5.9.0"
  }
}
