{
  "expo": {
    "name": "SparQFire",
    "slug": "sparqfire",
    "owner": "azlabsllc",
    "scheme": "sparqfire",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/sparqfireIcon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphazonelabs.sparqfire",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alphazonelabs.sparqfire",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/sparqfireIcon.png",
        "backgroundColor": "#111827"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "SparQFire",
      "favicon": "./assets/brand/sparqfireIcon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8e66d8fe-4c5d-4df6-8171-2d3306bf631f"
      }
    }
  }
}
